#!/bin/sh
#
# Apps for the propeller-driven helicopter blade (Boomerang) vehicle.
#
# ARCHITECTURE
# ────────────
# boomerang_estimator  — companion observer: publishes vehicle_attitude_virtual,
#                        despun vehicle_angular_velocity, and boomerang_azimuth.
#                        Must start BEFORE mc_att_control and control_allocator
#                        so overridden topics are live before consumers start.
#
# mc_att_control       — reads vehicle_attitude_virtual (modified to subscribe
#                        to that topic instead of vehicle_attitude).
#
# mc_rate_control      — reads despun vehicle_angular_velocity override.
#
# control_allocator    — uses ActuatorEffectivenessBoomerang (CA_AIRFRAME=15),
#                        reads boomerang_azimuth for live blade azimuths.
#                        Must start AFTER boomerang_estimator.
#
# START ORDER MATTERS — do not reorder.

# -----------------------------------------------------------------------
# 1. Estimator first — overrides vehicle_angular_velocity and publishes
#    vehicle_attitude_virtual before any consumer starts.
# -----------------------------------------------------------------------
boomerang_estimator start

# Brief pause to ensure first publications are live before consumers start
sleep 1

# -----------------------------------------------------------------------
# 2. Attitude and rate control — both now operate in the virtual frame.
#    MC_YAW_WEIGHT=0 should be set in parameters (yaw not controllable).
# -----------------------------------------------------------------------
mc_att_control start
mc_rate_control start

# -----------------------------------------------------------------------
# 3. Control allocator — uses ActuatorEffectivenessBoomerang.
#    CA_AIRFRAME must be set to 15 (Boomerang) in parameters.
# -----------------------------------------------------------------------
control_allocator start

# -----------------------------------------------------------------------
# 4. Position control stack.
# -----------------------------------------------------------------------
mc_hover_thrust_estimator start
flight_mode_manager start
mc_pos_control start

# -----------------------------------------------------------------------
# 5. Land detector.
# -----------------------------------------------------------------------
land_detector start multicopter

# -----------------------------------------------------------------------
# 6. Heading LED indicator.
#    Reads vehicle_attitude_virtual for current yaw and BC_VIRT_HDG for
#    the reference heading written by boomerang_estimator at startup.
# -----------------------------------------------------------------------
# sleep 10
heading_led start
