#!/bin/sh
#
# Apps for the propeller-driven helicopter blade vehicle.
#
# Replaces mc_apps for this airframe.
# Omits control_allocator and mc_rate_control — both are replaced
# by boomerang_controller which owns actuator_motors and actuator_servos
# directly and does its own azimuth-scheduled mixing.

# Safety net: if control_allocator or mc_rate_control were started by
# any earlier script, stop them now before boomerang takes ownership
# of actuator_motors and actuator_servos.
#mc_rate_control stop > /dev/null 2>&1
control_allocator stop > /dev/null 2>&1

mc_rate_control start

#
# Start Multicopter Attitude Controller.
# mc_att_control runs normally but with MC_YAW_WEIGHT=0 so it
# ignores yaw error (yaw is not controllable on this vehicle).
#
mc_att_control start


#
# Start Multicopter Position Controller stack.
#
mc_hover_thrust_estimator start
flight_mode_manager start
mc_pos_control start

#
# Start Land Detector.
#
land_detector start multicopter

#
# Start the boomerang controller.
# This replaces mc_rate_control and control_allocator.
# Must start AFTER mc_att_control and mc_pos_control so that
# vehicle_attitude_setpoint is already being published when
# boomerang_controller begins its first loop tick.
#
boomerang start
# pause to let boomerang_controller start and publish its first vehicle_attitude_virtual
sleep 1

heading_led start
